# Privy (optional — email login for a persistent embedded wallet).
# Guest mode works without these. Dashboard: https://dashboard.privy.io
# Set the Android app identifier to `com.zorr.app` under App settings > Clients.
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-client-id

# Google Maps Android API key (restrict it to package com.zorr.app + your SHA-1).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-android-key

# The Zorr game wallet that signs on-chain runs. Generate with:
#   solana-keygen new --no-bip39-passphrase -o zorr.json
# then paste the JSON byte array here and fund the address with devnet SOL.
EXPO_PUBLIC_ZORR_SIGNER_SECRET=[/* 64-byte secret key array */]
