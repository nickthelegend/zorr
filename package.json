{
  "name": "zorr",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "relay": "node server/relay.mjs",
    "test": "jest",
    "test:integration": "node scripts/integration.mjs",
    "test:socket": "node scripts/socket-integration.mjs",
    "web": "expo start --web",
    "postinstall": "node -e \"try{require('fs').writeFileSync('node_modules/expo-nearby-connections/android/fix-prefab.gradle','// no-op restored\n')}catch(e){}\""
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-reanimated|expo-modules-core)/)"
    ]
  },
  "displayName": "Privy Mobile Kit Expo example",
  "description": "A Solana mobile app with Expo, Privy auth, Solana Kit, and Uniwind.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "privy",
    "react-native",
    "solana-kit",
    "tailwind",
    "uniwind"
  ],
  "create-solana-dapp": {
    "instructions": [
      "Set up your Privy app:",
      "+1. Log in or sign up at https://dashboard.privy.io",
      "+2. Open https://dashboard.privy.io/organization-overview and click New app",
      "+3. Enter your app name, select Mobile app, and click Create app",
      "+4. Save the App ID, then click Close",
      "+5. Go to User management > Authentication",
      "+6. In the External wallets card, enable SVM (Solana) wallets",
      "+7. Go to App settings > Clients",
      "+8. Set the app identifier to the expo.android.package value from app.json",
      "+9. Save the Client ID for the default mobile app client",
      "",
      "Configure your environment:",
      "+cp .env.example .env",
      "EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id",
      "EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-client-id",
      "",
      "Do not put the Privy app secret in .env; this Expo app only uses public client-side Privy identifiers.",
      "",
      "Build the Android app locally:",
      "+{pm} run android"
    ],
    "versions:": {
      "adb": "33.0.0"
    }
  },
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@privy-io/expo": "^0.65.5",
    "@privy-io/expo-native-extensions": "^0.0.11",
    "@solana-program/memo": "^0.11.0",
    "@solana/kit": "^6.1.0",
    "@tanstack/react-query": "^5.100.10",
    "@wallet-ui/react-native-kit": "^4.0.1",
    "expo": "~55.0.23",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.15",
    "expo-blur": "~55.0.15",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "^55.0.18",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-linear-gradient": "~55.0.15",
    "expo-linking": "~55.0.8",
    "expo-location": "~55.1.11",
    "expo-nearby-connections": "^1.1.0",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.16",
    "fast-text-encoding": "^1.0.6",
    "heroui-native": "^1.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "lottie-react-native": "~7.3.4",
    "lucide-react-native": "^1.23.0",
    "react": "~19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "0.35.6",
    "react-native-passkeys": "^0.4.1",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-quick-crypto": "^1.0.7",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.12.1",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "~4.1.16",
    "uniwind": "1.6.5",
    "viem": "2.47.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "ws": "^8.21.0"
  },
  "private": true
}
