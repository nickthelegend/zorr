{
  "expo": {
    "scheme": "zorr",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static"
    },
    "name": "zorr",
    "slug": "zorr",
    "android": {
      "package": "com.zorr.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "./plugins/with-openssl-libs",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zorr uses your location to capture real-world territory as you walk."
        }
      ]
    ]
  }
}
