{
  "expo": {
    "scheme": "zorr",
    "userInterfaceStyle": "dark",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "web": {
      "output": "static"
    },
    "name": "Zorr",
    "slug": "zorr",
    "android": {
      "package": "com.zorr.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06060A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "./plugins/with-openssl-libs",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zorr uses your location to capture real-world territory as you walk."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#06060A",
          "imageWidth": 200
        }
      ],
      "expo-nearby-connections"
    ]
  }
}
